        input.value = '';
        input.click();
      });
      qs('#mediaDropzone').addEventListener('click', () => qs('#uploadMedia').click());
      qs('#mediaFiles').addEventListener('change', (event) => uploadMediaFiles(event.target.files));
      qs('#mediaSearch').addEventListener('input', renderMediaLibrary);
      qs('#mediaFolderFilter').addEventListener('change', renderMediaLibrary);
      qs('#mediaGrid').addEventListener('click', (event) => {
        const copyAction = event.target.closest('[data-copy-value]');
        if (copyAction) {
          copyMediaText(copyAction.dataset.copyValue || '', copyAction.dataset.copyKind === 'markdown' ? 'Markdown 图片语法已复制。' : '图片地址已复制。');
          return;
        }
        const editAction = event.target.closest('[data-media-edit]');
        if (editAction) {
          const item = mediaItems.find((media) => media.relativePath === editAction.dataset.mediaEdit);
          if (item) openMediaEditor(item);
          return;
        }
        const deleteAction = event.target.closest('[data-media-delete]');
        if (deleteAction) {
          const item = mediaItems.find((media) => media.relativePath === deleteAction.dataset.mediaDelete);
          if (item) deleteMedia(item);
        }
      });
      qs('#mediaEditForm').addEventListener('submit', (event) => {
        event.preventDefault();
        saveMediaEdit();
      });
      qsa('.media-dialog-close, .media-dialog-cancel').forEach((button) => button.addEventListener('click', () => qs('#mediaEditDialog').close()));

      const mediaDropzone = qs('#mediaDropzone');
      ['dragenter', 'dragover'].forEach((eventName) => mediaDropzone.addEventListener(eventName, (event) => {
        event.preventDefault();
        mediaDropzone.classList.add('drag-active');
      }));
      ['dragleave', 'drop'].forEach((eventName) => mediaDropzone.addEventListener(eventName, (event) => {
        event.preventDefault();
        mediaDropzone.classList.remove('drag-active');

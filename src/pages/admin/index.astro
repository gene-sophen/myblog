        qsa('[data-panel]').forEach((panel) => panel.classList.toggle('hidden', panel.dataset.panel !== button.dataset.tab));
        if (button.dataset.tab === 'media') loadMediaLibrary();
      }));

      qs('#refreshMedia').addEventListener('click', () => loadMediaLibrary(true));
      qs('#uploadMedia').addEventListener('click', () => {

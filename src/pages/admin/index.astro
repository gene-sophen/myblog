        border-radius: 20px;
      }

      .project-title-field input,
      .article-title-field input {
        font-size: 24px;
      }
    }
  </style>

  <script>
    // @ts-nocheck
    const loginForm = document.querySelector('#loginForm');
    if (loginForm) {
      loginForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const message = document.querySelector('#loginMessage');
        const submitButton = loginForm.querySelector('button[type="submit"]');
        const password = new FormData(loginForm).get('password');
        submitButton.disabled = true;
        message.textContent = '正在登录...';
        try {
          const response = await fetch('/api/admin/login', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ password })
          });
          if (response.ok) location.reload();
          else {
            const result = await response.json().catch(() => ({}));
            message.textContent = result.error || '登录失败，请检查密码。';
          }
        } catch {
          message.textContent = '网络异常，请重试。';
        } finally {
          submitButton.disabled = false;
        }
      });
    }

    const studio = document.querySelector('#studio');
    if (studio) {
      let state = { settings: {}, projects: [], articles: [] };
      let savedSnapshot = { settings: {}, projects: [], articles: [] };
      let projectIndex = 0;
      let articleIndex = 0;
      let isDirty = false;
      let articlePage = 1;
      const articlePageSize = 12;
      const articleFilters = { query: '', status: 'all', kind: 'all', sort: 'date-desc' };
      let mediaItems = [];
      let mediaLoaded = false;
      let mediaLoading = false;
      let editingMediaPath = '';
      let lastSessionActivity = Date.now();
      let lastSessionHeartbeat = Date.now();
      let handlingSessionExpiry = false;

      const qs = (selector) => document.querySelector(selector);
      const qsa = (selector) => Array.from(document.querySelectorAll(selector));
      const splitList = (value) => String(value || '').split(',').map((item) => item.trim()).filter(Boolean);
      const lines = (value) => String(value || '').split('\n').map((item) => item.trim()).filter(Boolean);
      const slugPattern = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
      const articleKinds = ['spec', 'devlog', 'tool', 'interview', 'job', 'resume', 'essay'];
      const articleStatuses = ['draft', 'published'];
      const articleKindDefaults = {
        spec: '项目说明书',
        devlog: '开发日志',
        tool: '工具箱',
        interview: '面经实录',
        job: '求职心路',
        resume: '简历经验',
        essay: '随笔'
      };
      const articleTemplates = {
        devlog: '## 背景\\n\\n这次改动从什么问题开始？\\n\\n## 实现\\n\\n核心实现路径、关键取舍和遇到的坑。\\n\\n## 结果\\n\\n现在完成了什么，还剩什么。\\n\\n## 下一步\\n\\n接下来准备继续推进的事项。\\n',
        spec: '## 目标\\n\\n这个项目要解决什么问题？\\n\\n## 内容模型\\n\\n- 核心实体\\n- 页面入口\\n- 数据流向\\n\\n## 技术方案\\n\\n为什么这样设计？\\n\\n## 维护方式\\n\\n如何持续更新和部署。\\n',
        tool: '## 适用场景\\n\\n什么时候会用到这个工具？\\n\\n## 使用方式\\n\\n```bash\\n# command here\\n```\\n\\n## 注意事项\\n\\n容易踩坑的地方。\\n',
        interview: '## 提问内容\\n\\n- 问题一\\n- 问题二\\n\\n## 回答思路\\n\\n先说结论，再补原理，最后给工程实践。\\n\\n## 事后反思\\n\\n哪些地方答得好，哪些地方需要补。\\n',
        essay: '## 记录\\n\\n这个月最值得记录的一件事。\\n\\n## 变化\\n\\n我做出了什么调整？\\n\\n## 复盘\\n\\n下个月要继续坚持或修正什么。\\n'
      };
      const saveRecoveryDraft = () => {
        if (!isDirty) return;
        try {
          sessionStorage.setItem('codepulse-admin-recovery', JSON.stringify({
            settings: state.settings,
            projects: state.projects,
            articles: state.articles
          }));
        } catch {}
      };
      const handleSessionExpiry = () => {
        if (handlingSessionExpiry) return;
        handlingSessionExpiry = true;
        saveRecoveryDraft();
        alert(isDirty
          ? '登录已过期，未保存的内容已暂存。请重新登录后继续编辑。'
          : '登录已过期，请重新登录。');
        location.reload();
      };
      const heartbeatSession = async () => {
        if (handlingSessionExpiry || document.visibilityState !== 'visible') return;
        lastSessionHeartbeat = Date.now();
        try {
          const response = await fetch('/api/admin/content', { headers: { 'x-admin-session-heartbeat': '1' } });
          if (response.status === 401) handleSessionExpiry();
        } catch {}
      };
      const recordSessionActivity = () => {
        lastSessionActivity = Date.now();
        if (lastSessionActivity - lastSessionHeartbeat > 8 * 60 * 1000) heartbeatSession();
      };
      ['pointerdown', 'keydown', 'input', 'change', 'focus'].forEach((eventName) => {
        window.addEventListener(eventName, recordSessionActivity, { passive: true });
      });
      window.setInterval(() => {
        if (Date.now() - lastSessionActivity < 10 * 60 * 1000 && Date.now() - lastSessionHeartbeat > 8 * 60 * 1000) {
          heartbeatSession();
        }
      }, 60 * 1000);
      const escapeHtml = (value) => String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
      const progressFromText = (value) => lines(value).map((row) => {
        const [label, rawValue] = row.split(':');
        const nextValue = Math.min(100, Math.max(0, Number(rawValue || 0) || 0));
        return { label: (label || '').trim(), value: nextValue };
      }).filter((item) => item.label);
      const progressToText = (items) => (items || []).map((item) => `${item.label}:${item.value}`).join('\n');
      const today = () => new Date().toISOString().slice(0, 10);

      function parseFrontmatterScalar(value) {
        const next = String(value || '').trim();
        if (next === 'true') return true;
        if (next === 'false') return false;
        if (/^-?\d+(\.\d+)?$/.test(next)) return Number(next);
        if ((next.startsWith('"') && next.endsWith('"')) || (next.startsWith("'") && next.endsWith("'"))) {
          try {
            return JSON.parse(next);
          } catch {
            return next.slice(1, -1);
          }
        }
        return next;
      }

      function parseFrontmatter(markdown) {
        const source = String(markdown || '').replace(/\r\n/g, '\n').replace(/^\uFEFF/, '').trimStart();
        if (!source.startsWith('---\n')) return { data: {}, body: source.trimStart(), hasFrontmatter: false };
        const closingMatch = source.slice(4).match(/\n---[ \t]*(?:\n|$)/);
        if (!closingMatch || closingMatch.index === undefined) return { data: {}, body: source.trimStart(), hasFrontmatter: false };

        const data = {};
        const closingIndex = 4 + closingMatch.index;
        const closingEnd = closingIndex + closingMatch[0].length;
        const frontmatter = source.slice(4, closingIndex).trim();
        const body = source.slice(closingEnd).replace(/^\n/, '');
        const rows = frontmatter.split('\n');
        for (let index = 0; index < rows.length; index += 1) {
          const row = rows[index];
          if (!row.trim() || row.trimStart().startsWith('#') || row.startsWith(' ') || row.startsWith('\t')) continue;
          const match = row.match(/^([A-Za-z][\w-]*):(?:\s*(.*))?$/);
          if (!match) continue;
          const key = match[1];
          const rawValue = match[2] || '';
          if (rawValue.trim()) {
            data[key] = parseFrontmatterScalar(rawValue);
            continue;
          }
          const items = [];
          while (index + 1 < rows.length && /^\s+-\s+/.test(rows[index + 1])) {
            index += 1;
            items.push(String(parseFrontmatterScalar(rows[index].replace(/^\s+-\s+/, ''))));
          }
          data[key] = items;
        }
        return { data, body, hasFrontmatter: true };
      }

      function valueAsString(value) {
        return typeof value === 'string' ? value : value === undefined || value === null ? '' : String(value);
      }

      function valueAsList(value) {
        return Array.isArray(value) ? value.map(String).filter(Boolean) : [];
      }

      function slugify(value) {
        return String(value || '')
          .toLowerCase()
          .trim()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
      }

      function parseArticleMarkdown(markdown, fileName = '') {
        const { data, body, hasFrontmatter } = parseFrontmatter(markdown);
        const fileSlug = slugify(fileName.replace(/\.[^.]+$/, ''));
        const kind = articleKinds.includes(valueAsString(data.kind)) ? valueAsString(data.kind) : 'devlog';
        const slug = valueAsString(data.slug) || fileSlug || slugify(data.title) || `imported-${Date.now()}`;
        const article = {
          slug,
          title: valueAsString(data.title),
          date: valueAsString(data.date) || today(),
          kind,
          category: valueAsString(data.category) || articleKindDefaults[kind],
          projectSlug: valueAsString(data.projectSlug),
          lifecycle: valueAsString(data.lifecycle),
        tags: valueAsList(data.tags),
          status: articleStatuses.includes(valueAsString(data.status)) ? valueAsString(data.status) : 'draft',
          company: valueAsString(data.company),
          position: valueAsString(data.position),
          excerpt: valueAsString(data.excerpt),
          content: body.trim()
        };
        return { article, hasFrontmatter };
      }

      function validateImportedArticle(article, hasFrontmatter) {
        const errors = [];
        if (!hasFrontmatter) errors.push('文件需要包含 frontmatter，格式以 --- 开始和结束。');
        if (!article.title) errors.push('frontmatter.title 不能为空。');
        if (!slugPattern.test(article.slug)) errors.push('slug 只能使用小写字母、数字和短横线。');
        if (!/^\d{4}-\d{2}-\d{2}$/.test(article.date) || Number.isNaN(Date.parse(`${article.date}T00:00:00.000Z`))) {
          errors.push('date 必须是 YYYY-MM-DD 格式。');
        }
        if (!articleKinds.includes(article.kind)) errors.push('kind 必须是 spec、devlog、tool、interview、job、resume 或 essay。');
        if (!articleStatuses.includes(article.status)) errors.push('status 必须是 draft 或 published。');
        if (article.projectSlug && !slugPattern.test(article.projectSlug)) errors.push('projectSlug 只能使用小写字母、数字和短横线。');
        if (article.lifecycle && !['ongoing', 'archived'].includes(article.lifecycle)) errors.push('lifecycle 只能是 ongoing、archived 或留空。');
        if (!article.content) errors.push('正文不能为空。');
        return errors;
      }

      function makeUniqueArticleSlug(slug, taken = new Set(state.articles.map((article) => article.slug))) {
        const base = slugPattern.test(slug) ? slug : 'imported-article';
        let next = base;
        let counter = 2;
        while (taken.has(next)) {
          next = `${base}-${counter}`;
          counter += 1;
        }
        return next;
      }

      function renderArticleImportResult({ imported = [], renamed = [], errors = [] }) {
        const panel = qs('#articleImportResult');
        if (!panel) return;
        panel.classList.remove('hidden');
        panel.innerHTML = `
          <div class="import-panel-head">
            <div>
              <p class="eyebrow">Markdown Import</p>
              <h3>${imported.length ? `已导入 ${imported.length} 篇文章` : '导入未完成'}</h3>
            </div>
            <button class="btn secondary" id="closeArticleImportResult" type="button">关闭</button>
          </div>
          ${imported.length ? `<div class="import-result-list">${imported.map(({ article, fileName }) => `
            <div class="import-result-item">
              <div><strong>${escapeHtml(article.title)}</strong><span>${escapeHtml(fileName)} · ${escapeHtml(article.slug)}</span></div>
              <button class="btn secondary" type="button" data-imported-article="${escapeHtml(article.slug)}">查看</button>
            </div>
          `).join('')}</div>` : ''}
          ${renamed.length ? `<div class="import-warning">${renamed.map(({ fileName, from, to }) => `<div>${escapeHtml(fileName)}：Slug ${escapeHtml(from)} 已存在，已改为 ${escapeHtml(to)}。</div>`).join('')}</div>` : ''}
          ${errors.length ? `<div class="import-errors">${errors.map(({ fileName, messages }) => `<div><strong>${escapeHtml(fileName)}</strong>：${messages.map(escapeHtml).join('；')}</div>`).join('')}</div>` : ''}
        `;

        qs('#closeArticleImportResult')?.addEventListener('click', () => {
          panel.classList.add('hidden');
          panel.innerHTML = '';
        });
        qsa('[data-imported-article]').forEach((button) => button.addEventListener('click', () => {
          readArticleForm();
          const nextIndex = state.articles.findIndex((article) => article.slug === button.dataset.importedArticle);
          if (nextIndex < 0) return;
          focusArticle(nextIndex, { resetFilters: true });
          renderArticles();
          qs('#articleForm')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }));
        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      function downloadTemplate() {
        const template = `---\nslug: \"my-devlog\"\ntitle: \"一次开发日志\"\ndate: \"${today()}\"\nstatus: \"draft\"\nkind: \"devlog\"\ncategory: \"开发日志\"\nprojectSlug: \"codepulse-blog\"\nlifecycle: \"ongoing\"\ntags:\n  - \"Astro\"\n  - \"Markdown\"\ncompany: \"\"\nposition: \"\"\nexcerpt: \"这里写文章摘要。\"\n---\n\n## 背景\n\n这里开始写正文。\n`;
        const url = URL.createObjectURL(new Blob([template], { type: 'text/markdown;charset=utf-8' }));
        const link = document.createElement('a');
        link.href = url;
        link.download = `article-template-${today()}.md`;
        document.body.append(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
      }

      function quoteYaml(value) {
        return JSON.stringify(String(value ?? ''));
      }

      function stringifyFrontmatter(data) {
        const rows = ['---'];
        Object.entries(data).forEach(([key, value]) => {
          if (Array.isArray(value)) {
            rows.push(`${key}:`);
            value.forEach((item) => rows.push(`  - ${quoteYaml(item)}`));
          } else if (typeof value === 'boolean' || typeof value === 'number') {
            rows.push(`${key}: ${value}`);
          } else {
            rows.push(`${key}: ${quoteYaml(value)}`);
          }
        });
        rows.push('---');
        return `${rows.join('\n')}\n\n`;
      }

      function articleToMarkdown(article) {
        return `${stringifyFrontmatter({
          slug: article.slug,
          title: article.title,
          date: article.date,
          status: article.status || 'draft',
          kind: article.kind,
          category: article.category,
          projectSlug: article.projectSlug || '',
          lifecycle: article.lifecycle || '',
          tags: article.tags || [],
          company: article.company || '',
          position: article.position || '',
          excerpt: article.excerpt || ''
        })}${String(article.content || '').trim()}\n`;
      }

      function markdownList(items) {
        return items?.length ? items.map((item) => `- ${item}`).join('\n') : '- ';
      }

      function projectToMarkdown(project) {
        return `${stringifyFrontmatter({
          slug: project.slug,
          name: project.name,
          status: project.status,
          statusLabel: project.statusLabel,
          tech: project.tech || [],
          progress: (project.progress || []).map((item) => `${item.label}:${item.value}`),
          releaseNote: project.releaseNote || '',
          featured: Boolean(project.featured)
        })}## 项目简介\n\n${project.summary || ''}\n\n## 近期进展\n\n${project.monthUpdate || ''}\n\n## 架构流程\n\n${markdownList(project.architecture || [])}\n`;
      }

      function settingsToMarkdown(settings) {
        return `${stringifyFrontmatter({
          siteTitle: settings.siteTitle,
          siteSubtitle: settings.siteSubtitle,
          ownerName: settings.ownerName,
          ownerInitial: settings.ownerInitial,
          identity: settings.identity,
          github: settings.github,
          email: settings.email,
          location: settings.location,
          adminTitle: settings.adminTitle
        })}## 博客简介\n\n${settings.bio || ''}\n\n## 状态播报\n\n${settings.status || ''}\n`;
      }

      function extractSection(body, heading) {
        const source = String(body || '').replace(/\r\n/g, '\n');
        const escaped = heading.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const match = source.match(new RegExp(`^##\\s+${escaped}\\s*$`, 'm'));
        if (!match || match.index === undefined) return '';
        const rest = source.slice(match.index + match[0].length).replace(/^\n+/, '');
        const nextHeading = rest.search(/^##\s+/m);
        return (nextHeading === -1 ? rest : rest.slice(0, nextHeading)).trim();
      }

      function listFromSection(body, heading) {
        return extractSection(body, heading).split('\n').map((line) => line.trim().replace(/^-\s+/, '')).filter(Boolean);
      }

      function parseSettingsMarkdown(markdown) {
        const { data, body, hasFrontmatter } = parseFrontmatter(markdown);
        if (!hasFrontmatter) throw new Error('设置文件需要 frontmatter。');
        return {
          siteTitle: valueAsString(data.siteTitle),
          siteSubtitle: valueAsString(data.siteSubtitle),
          ownerName: valueAsString(data.ownerName),
          ownerInitial: valueAsString(data.ownerInitial),
          identity: valueAsString(data.identity),
          github: valueAsString(data.github),
          email: valueAsString(data.email),
          location: valueAsString(data.location),
          adminTitle: valueAsString(data.adminTitle),
          bio: extractSection(body, '博客简介') || valueAsString(data.bio),
          status: extractSection(body, '状态播报') || valueAsString(data.status)
        };
      }

      function parseProjectMarkdown(markdown, fileName = '') {
        const { data, body, hasFrontmatter } = parseFrontmatter(markdown);
        if (!hasFrontmatter) throw new Error('项目文件需要 frontmatter。');
        return {
          slug: valueAsString(data.slug) || slugify(fileName.replace(/\.[^.]+$/, '')),
          name: valueAsString(data.name),
          status: valueAsString(data.status) || 'ongoing',
          statusLabel: valueAsString(data.statusLabel),
          tech: valueAsList(data.tech),
          progress: progressFromText(valueAsList(data.progress).join('\n')),
          summary: extractSection(body, '项目简介'),
          monthUpdate: extractSection(body, '近期进展'),
          releaseNote: valueAsString(data.releaseNote),
          architecture: listFromSection(body, '架构流程'),
          featured: data.featured === true || data.featured === 'true'
        };
      }

      function downloadText(fileName, body) {
        const url = URL.createObjectURL(new Blob([body], { type: 'text/markdown;charset=utf-8' }));
        const link = document.createElement('a');
        link.href = url;
        link.download = fileName;
        document.body.append(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);
      }

      function stableStringify(value) {
        return JSON.stringify(value ?? null);
      }

      function buildDiffSummary() {
        const articleBefore = new Map((savedSnapshot.articles || []).map((article) => [article.slug, article]));
        const articleAfter = new Map((state.articles || []).map((article) => [article.slug, article]));
        const projectBefore = new Map((savedSnapshot.projects || []).map((project) => [project.slug, project]));
        const projectAfter = new Map((state.projects || []).map((project) => [project.slug, project]));
        const added = [];
        const changed = [];
        const removed = [];
        const projectChanges = [];
        articleAfter.forEach((article, slug) => {
          if (!articleBefore.has(slug)) added.push(article.title || slug);
          else if (stableStringify(articleBefore.get(slug)) !== stableStringify(article)) changed.push(article.title || slug);
        });
        articleBefore.forEach((article, slug) => {
          if (!articleAfter.has(slug)) removed.push(article.title || slug);
        });
        projectAfter.forEach((project, slug) => {
          if (!projectBefore.has(slug)) projectChanges.push(`新增 ${project.name || slug}`);
          else if (stableStringify(projectBefore.get(slug)) !== stableStringify(project)) projectChanges.push(`修改 ${project.name || slug}`);
        });
        projectBefore.forEach((project, slug) => {
          if (!projectAfter.has(slug)) projectChanges.push(`删除 ${project.name || slug}`);
        });
        const settingsChanged = stableStringify(savedSnapshot.settings) !== stableStringify(state.settings);
        return { added, changed, removed, projectChanges, settingsChanged };
      }

      function confirmSaveDiff() {
        const diff = buildDiffSummary();
        const lines = [
          '保存前差异预览：',
          `新增文章：${diff.added.length ? diff.added.join('、') : '无'}`,
          `修改文章：${diff.changed.length ? diff.changed.join('、') : '无'}`,
          `删除文章：${diff.removed.length ? diff.removed.join('、') : '无'}`,
          `项目变化：${diff.projectChanges.length ? diff.projectChanges.join('、') : '无'}`,
          `站点设置：${diff.settingsChanged ? '有修改' : '无修改'}`,
          '',
          '确认后会写入 content 目录下的 Markdown 文件。'
        ];
        return confirm(lines.join('\n'));
      }

      function buildContentIssues() {
        const issues = [];
        const projectSlugs = new Set(state.projects.map((project) => project.slug));
        const articleSlugs = new Set();
        state.articles.forEach((article) => {
          if (articleSlugs.has(article.slug)) issues.push(`文章 slug 重复：${article.slug}`);
          articleSlugs.add(article.slug);
          if (!article.title) issues.push(`${article.slug || '未命名文章'} 缺少标题`);
          if (!article.excerpt) issues.push(`${article.title || article.slug} 缺少摘要`);
          if (!article.content) issues.push(`${article.title || article.slug} 正文为空`);
          if (!slugPattern.test(article.slug || '')) issues.push(`${article.title || '未命名文章'} slug 不合法`);
          if (article.projectSlug && !projectSlugs.has(article.projectSlug)) {
            issues.push(`${article.title || article.slug} 关联了不存在的项目：${article.projectSlug}`);
          }
          const imageMatches = String(article.content || '').matchAll(/!\[[^\]]*\]\(([^)]+)\)/g);
          for (const match of imageMatches) {
            const imagePath = match[1];
            if (!imagePath.startsWith('/') && !/^https?:\/\//i.test(imagePath)) {
              issues.push(`${article.title || article.slug} 使用了相对图片路径：${imagePath}`);
            }
          }
        });
        state.projects.forEach((project) => {
          if (!project.name) issues.push(`${project.slug || '未命名项目'} 缺少项目名称`);
          if (!project.summary) issues.push(`${project.name || project.slug} 缺少项目简介`);
        });
        return issues;
      }

      function renderContentAudit() {
        readProjectForm();
        readArticleForm();
        const panel = qs('#contentAuditPanel');
        const issues = buildContentIssues();
        panel.classList.remove('hidden');
        panel.innerHTML = `
          <div class="import-panel-head">
            <div>
              <p class="eyebrow">Content Audit</p>
              <h3>内容体检</h3>
            </div>
            <button class="btn secondary" id="closeContentAudit" type="button">关闭</button>
          </div>
          ${issues.length ? `<div class="import-errors">${issues.map((issue) => `<div>${escapeHtml(issue)}</div>`).join('')}</div>` : '<div class="import-warning">没有发现明显问题。</div>'}
        `;
        qs('#closeContentAudit').addEventListener('click', () => {
          panel.classList.add('hidden');
          panel.innerHTML = '';
        });
      }

      function insertIntoArticleContent(text) {
        const textarea = qs('#articleForm textarea[name="content"]');
        if (!textarea) return;
        const start = textarea.selectionStart ?? textarea.value.length;
        const end = textarea.selectionEnd ?? textarea.value.length;
        textarea.value = `${textarea.value.slice(0, start)}${text}${textarea.value.slice(end)}`;
        textarea.focus();
        textarea.selectionStart = textarea.selectionEnd = start + text.length;
        readArticleForm();
        setDirty(true);
      }

      function setDirty(value = true) {
        isDirty = value;
        const message = qs('#saveMessage');
        if (message && value) message.textContent = '有未保存更改。';
      }

      const syncStudioDraft = (event) => {
        if (event.target.closest('[data-panel="media"]')) return;
        if (event.target.closest('#articleForm')) readArticleForm();
        setDirty(true);
      };
      studio.addEventListener('input', syncStudioDraft);
      studio.addEventListener('change', syncStudioDraft);
      window.addEventListener('beforeunload', (event) => {
        if (!isDirty) return;
        event.preventDefault();
        event.returnValue = '';
      });

      function syncOpenLinks() {
        const selectedProject = state.projects[projectIndex];
        const selectedArticle = state.articles[articleIndex];
        const projectUrl = selectedProject?.slug ? `/project/${encodeURIComponent(selectedProject.slug)}` : '/projects';
        const articleUrl = selectedArticle?.slug ? `/articles/${encodeURIComponent(selectedArticle.slug)}` : '/';
        const projectLink = qs('#projectPreviewLink');
        const articleLink = qs('#articlePreviewLink');

        if (projectLink) projectLink.href = projectUrl;
        if (articleLink) articleLink.href = articleUrl;
      }

      function formatFileSize(bytes) {
        if (!Number.isFinite(bytes) || bytes < 0) return '未知大小';
        if (bytes < 1024) return `${bytes} B`;
        if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(bytes < 10 * 1024 ? 1 : 0)} KB`;
        return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
      }

      async function copyMediaText(value, successMessage) {
        try {
          await navigator.clipboard.writeText(value);
          qs('#mediaMessage').textContent = successMessage;
        } catch {
          qs('#mediaMessage').textContent = '复制失败，请确认浏览器已允许剪贴板权限。';
        }
      }

      function updateMediaReferencesInState(previousUrl, nextUrl) {
        if (!previousUrl || !nextUrl || previousUrl === nextUrl) return 0;
        const escapedUrl = previousUrl.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const pattern = new RegExp(`(!\\[[^\\]]*\\]\\(\\s*)${escapedUrl}(?=\\s*(?:"[^"]*"|'[^']*')?\\s*\\))`, 'g');
        const updateArticles = (articles, countChanges) => {
          let changed = 0;
          articles.forEach((article) => {
            const nextContent = String(article.content || '').replace(pattern, (_, prefix) => {
              if (countChanges) changed += 1;
              return `${prefix}${nextUrl}`;
            });
            article.content = nextContent;
          });
          return changed;
        };
        const changed = updateArticles(state.articles, true);
        updateArticles(savedSnapshot.articles, false);
        if (changed) renderArticleForm();
        return changed;
      }

      async function mediaRequest(method, body) {
        const response = await fetch('/api/admin/media', {
          method,
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(body)
        });
        const result = await response.json().catch(() => ({}));
        if (response.status === 401) {
          handleSessionExpiry();
          throw new Error('登录状态已过期');
        }
        if (!response.ok) {
          const referenceText = Array.isArray(result.references) && result.references.length
            ? `：${result.references.map((item) => item.title || item.slug).join('、')}`
            : '';
          throw new Error(`${result.error || `服务器返回 HTTP ${response.status}`}${referenceText}`);
        }
        return result;
      }

      function openMediaEditor(item) {
        const extension = item.name.match(/\.[^.]+$/)?.[0] || '';
        editingMediaPath = item.relativePath;
        qs('#mediaEditName').value = item.name.slice(0, extension ? -extension.length : undefined);
        qs('#mediaEditFolder').value = item.folder || 'library';
        qs('#mediaEditExtension').textContent = `文件格式 ${extension || '保持不变'}`;
        qs('#mediaEditDialog').showModal();
        qs('#mediaEditName').focus();
      }

      async function saveMediaEdit() {
        const button = qs('#saveMediaEdit');
        button.disabled = true;
        qs('#mediaMessage').textContent = '正在更新图片及文章引用...';
        try {
          const result = await mediaRequest('PATCH', {
            relativePath: editingMediaPath,
            name: qs('#mediaEditName').value,
            folder: qs('#mediaEditFolder').value
          });
          const updatedReferences = updateMediaReferencesInState(result.previousUrl, result.image?.url);
          qs('#mediaEditDialog').close();
          mediaLoaded = false;
          await loadMediaLibrary(true);
          qs('#mediaMessage').textContent = updatedReferences
            ? `图片已更新，并同步修改 ${updatedReferences} 处文章引用。`
            : '图片信息已更新。';
        } catch (error) {
          qs('#mediaMessage').textContent = error.message || '图片更新失败。';
        } finally {
          button.disabled = false;
        }
      }

      async function deleteMedia(item) {
        const escapedUrl = item.url.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const referencePattern = new RegExp(`!\\[[^\\]]*\\]\\(\\s*${escapedUrl}(?=\\s*(?:"[^"]*"|'[^']*')?\\s*\\))`);
        const localReferences = state.articles.filter((article) => referencePattern.test(String(article.content || '')));
        if (localReferences.length) {
          qs('#mediaMessage').textContent = `图片仍被文章引用：${localReferences.map((article) => article.title || article.slug).join('、')}。请先移除引用并保存文章。`;
          return;
        }
        if (!confirm(`确定永久删除图片“${item.name}”？此操作无法撤销。`)) return;
        qs('#mediaMessage').textContent = '正在检查文章引用并删除图片...';
        try {
          await mediaRequest('DELETE', { relativePath: item.relativePath });
          mediaLoaded = false;
          await loadMediaLibrary(true);
          qs('#mediaMessage').textContent = '图片已删除。';
        } catch (error) {
          qs('#mediaMessage').textContent = error.message || '图片删除失败。';
        }
      }

      function syncMediaFolderFilter() {
        const select = qs('#mediaFolderFilter');
        const selected = select.value;
        const folders = [...new Set(mediaItems.map((item) => item.folder || '').filter(Boolean))]
          .sort((a, b) => a.localeCompare(b, 'zh-CN'));
        select.innerHTML = [
          '<option value="">全部分组</option>',
          ...folders.map((folder) => `<option value="${escapeHtml(folder)}">${escapeHtml(folder)}</option>`)
        ].join('');
        select.value = folders.includes(selected) ? selected : '';
      }

      function renderMediaLibrary() {
        const grid = qs('#mediaGrid');
        const summary = qs('#mediaSummary');
        const folder = String(qs('#mediaFolderFilter')?.value || '');
        const query = String(qs('#mediaSearch')?.value || '').trim().toLowerCase();
        const grouped = mediaItems.filter((item) => !folder || item.folder === folder);
        const visible = grouped.filter((item) => !query || item.name.toLowerCase().includes(query));
        const scope = folder ? `“${folder}”分组` : '全部分组';
        summary.textContent = query
          ? `${scope}找到 ${visible.length} / ${grouped.length} 张`
          : `${scope}共 ${grouped.length} 张图片`;
        if (!visible.length) {
          const message = query
            ? '当前分组没有符合搜索条件的图片。'
            : folder ? '当前分组暂无图片。' : '图片库为空，上传第一张图片后会显示在这里。';
          grid.innerHTML = `<p class="media-empty">${message}</p>`;
          return;
        }

        grid.innerHTML = visible.map((item) => {
          const markdown = `![${item.name.replace(/\.[^.]+$/, '')}](${item.url})`;
          const modifiedAt = new Date(item.modifiedAt).toLocaleString();
          return `
            <article class="media-item">
              <img src="${escapeHtml(item.url)}" alt="${escapeHtml(item.name)}" loading="lazy" />
              <div class="media-item-body">
                <p class="media-item-name" title="${escapeHtml(item.relativePath)}">${escapeHtml(item.name)}</p>
                <p class="media-item-meta">${escapeHtml(item.folder || '根目录')} · ${escapeHtml(formatFileSize(item.size))}<br />${escapeHtml(modifiedAt)}</p>
                <div class="media-item-actions">
                  <button class="media-copy-action" type="button" data-copy-value="${escapeHtml(item.url)}" data-copy-kind="url">复制地址</button>
                  <button class="media-copy-action" type="button" data-copy-value="${escapeHtml(markdown)}" data-copy-kind="markdown">复制 Markdown</button>
                  <button class="media-copy-action" type="button" data-media-edit="${escapeHtml(item.relativePath)}">编辑</button>
                  <button class="media-copy-action media-delete-action" type="button" data-media-delete="${escapeHtml(item.relativePath)}">删除</button>
                </div>
              </div>
            </article>
          `;
        }).join('');
      }

      async function loadMediaLibrary(force = false) {
        if (mediaLoading || (mediaLoaded && !force)) return;
        mediaLoading = true;
        qs('#mediaSummary').textContent = '正在读取图片库...';
        try {
          const response = await fetch('/api/admin/upload-image');
          const result = await response.json().catch(() => ({}));
          if (response.status === 401) {
            handleSessionExpiry();
            return;
          }
          if (!response.ok) throw new Error(result.error || '读取图片库失败。');
          mediaItems = Array.isArray(result.images) ? result.images : [];
          mediaLoaded = true;
          syncMediaFolderFilter();
          renderMediaLibrary();
        } catch (error) {
          qs('#mediaSummary').textContent = '读取失败';
          qs('#mediaMessage').textContent = error.message || '读取图片库失败，请检查服务状态。';
        } finally {
          mediaLoading = false;
        }
      }

      async function uploadMediaFiles(files) {
        const selected = Array.from(files || []);
        if (!selected.length) return;
        const uploadButton = qs('#uploadMedia');
        const dropzone = qs('#mediaDropzone');
        const formData = new FormData();
        selected.forEach((file) => formData.append('images', file));
        formData.set('folder', qs('#mediaFolder').value || 'library');
        uploadButton.disabled = true;
        dropzone.disabled = true;
        qs('#mediaMessage').textContent = `正在上传 ${selected.length} 张图片...`;
        try {
          const response = await fetch('/api/admin/upload-image', { method: 'POST', body: formData });
          const responseText = await response.text();
          let result = {};
          try {
            result = responseText ? JSON.parse(responseText) : {};
          } catch {
            result = { error: responseText.trim().slice(0, 160) };
          }
          if (response.status === 401) {
            handleSessionExpiry();
            return;
          }
          const uploadedCount = Array.isArray(result.images) ? result.images.length : 0;
          const errors = Array.isArray(result.errors) ? result.errors : [];
          if (!response.ok && !uploadedCount) {
            const reason = result.error || errors[0]?.message || `服务器返回 HTTP ${response.status}`;
            throw new Error(`图片上传失败（${response.status}）：${reason}`);
          }
          mediaLoaded = false;
          await loadMediaLibrary(true);
          qs('#mediaMessage').textContent = errors.length
            ? `已上传 ${uploadedCount} 张，${errors.length} 张失败：${errors.slice(0, 2).map((item) => `${item.fileName}（${item.message}）`).join('；')}`
            : `已上传 ${uploadedCount} 张图片。`;
        } catch (error) {
          qs('#mediaMessage').textContent = error.message || '图片上传失败，请检查服务状态。';
        } finally {
          uploadButton.disabled = false;
          dropzone.disabled = false;
          qs('#mediaFiles').value = '';
        }
      }

      function field(name, label, value = '', options = {}) {
        const full = options.full ? ' full' : '';
        const tone = options.tone ? ` ${options.tone}` : '';
        const size = options.size ? ` ${options.size}` : '';
        const inputClass = options.content ? ' class="content-textarea"' : '';
        const placeholder = options.placeholder ? ` placeholder="${escapeHtml(options.placeholder)}"` : '';
        const hint = options.hint ? `<small>${escapeHtml(options.hint)}</small>` : '';
        const rows = options.rows ? ` rows="${escapeHtml(options.rows)}"` : '';
        const type = options.inputType || 'text';
        const suggestions = Array.isArray(options.suggestions)
          ? [...new Set(options.suggestions.map((item) => String(item).trim()).filter(Boolean))]
          : [];
        const listId = suggestions.length ? `${name}-suggestions` : '';
        const list = listId ? ` list="${escapeHtml(listId)}"` : '';
        const dataList = listId
          ? `<datalist id="${escapeHtml(listId)}">${suggestions.map((item) => `<option value="${escapeHtml(item)}"></option>`).join('')}</datalist>`
          : '';
        if (options.type === 'textarea') {
          return `<label class="field-card${full}${tone}${size}" data-field="${escapeHtml(name)}"><span class="field-top"><span>${escapeHtml(label)}</span>${hint}</span><textarea name="${escapeHtml(name)}"${inputClass}${placeholder}${rows}>${escapeHtml(value)}</textarea></label>`;
        }
        if (options.type === 'select') {
          return `<label class="field-card${full}${tone}${size}" data-field="${escapeHtml(name)}"><span class="field-top"><span>${escapeHtml(label)}</span>${hint}</span><select name="${escapeHtml(name)}">${options.choices.map((choice) => `<option value="${escapeHtml(choice.value)}" ${choice.value === value ? 'selected' : ''}>${escapeHtml(choice.label)}</option>`).join('')}</select></label>`;
        }
        return `<label class="field-card${full}${tone}${size}" data-field="${escapeHtml(name)}"><span class="field-top"><span>${escapeHtml(label)}</span>${hint}</span><input type="${escapeHtml(type)}" name="${escapeHtml(name)}" value="${escapeHtml(value)}"${placeholder}${list} />${dataList}</label>`;
      }

      function editorBlock(kicker, title, body, accent = '') {
        return `
          <section class="content-editor-block ${accent}">
            <div class="content-editor-head">
              <span>${escapeHtml(kicker)}</span>
              <h3>${escapeHtml(title)}</h3>
            </div>
            <div class="content-editor-grid">${body}</div>
          </section>
        `;
      }

      function settingControl(name, label, value = '', options = {}) {
        const placeholder = options.placeholder ? ` placeholder="${escapeHtml(options.placeholder)}"` : '';
        const tone = options.tone ? ` ${options.tone}` : '';
        const type = options.inputType || 'text';
        if (options.type === 'textarea') {
          return `
            <label class="setting-control${tone}" data-field="${escapeHtml(name)}">
              <span>${escapeHtml(label)}</span>
              <textarea name="${escapeHtml(name)}"${placeholder}>${escapeHtml(value)}</textarea>
            </label>
          `;
        }

        return `
          <label class="setting-control${tone}" data-field="${escapeHtml(name)}">
            <span>${escapeHtml(label)}</span>
            <input type="${escapeHtml(type)}" name="${escapeHtml(name)}" value="${escapeHtml(value)}"${placeholder} />
          </label>
        `;
      }


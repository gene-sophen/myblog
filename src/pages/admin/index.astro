      qs('#articleImageFile').addEventListener('change', async (event) => {
        event.stopPropagation();
        const file = event.target.files?.[0];
        if (!file) return;
        readArticleForm();
        const article = state.articles[articleIndex] || {};
        const formData = new FormData();
        formData.set('image', file);
        formData.set('articleSlug', article.slug || 'draft');
        qs('#saveMessage').textContent = '正在上传图片...';
        try {
          const response = await fetch('/api/admin/upload-image', { method: 'POST', body: formData });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) {
            if (response.status === 401) handleSessionExpiry();
            qs('#saveMessage').textContent = result.error || '图片上传失败。';
            return;
          }
          insertIntoArticleContent(`\n![${file.name.replace(/\.[^.]+$/, '')}](${result.path})\n`);
          qs('#saveMessage').textContent = '图片已上传，并插入正文。';
        } catch {
          qs('#saveMessage').textContent = '图片上传失败，请检查服务状态。';
        }
      });

      qs('#articleImportFile').addEventListener('change', async (event) => {
        event.stopPropagation();
        const files = Array.from(event.target.files || []);
        if (!files.length) return;
        readArticleForm();
        const candidates = [];
        const errors = [];
        for (const file of files) {
          try {
            const markdown = await file.text();
            const { article, hasFrontmatter } = parseArticleMarkdown(markdown, file.name);
            const messages = validateImportedArticle(article, hasFrontmatter);
            if (messages.length) errors.push({ fileName: file.name, messages });
            else candidates.push({ article, fileName: file.name });
          } catch {
            errors.push({ fileName: file.name, messages: ['读取失败，请确认文件是 UTF-8 编码的 Markdown。'] });
          }
        }

        const taken = new Set(state.articles.map((article) => article.slug));
        const renamed = [];
        const imported = candidates.map(({ article, fileName }) => {
          const originalSlug = article.slug;
          article.slug = makeUniqueArticleSlug(originalSlug, taken);
          taken.add(article.slug);
          if (article.slug !== originalSlug) renamed.push({ fileName, from: originalSlug, to: article.slug });
          return { article, fileName };
        });

        if (imported.length) {
          state.articles.unshift(...imported.map(({ article }) => article));
          focusArticle(0, { resetFilters: true });
          setDirty(true);
          renderArticles();
        }
        renderArticleImportResult({ imported, renamed, errors });
        qs('#saveMessage').textContent = imported.length
          ? `已导入 ${imported.length} 篇文章${errors.length ? `，另有 ${errors.length} 个文件格式有误` : ''}，点击“保存全部”后写入 Markdown 文件。`
          : `导入失败：${errors.length} 个文件格式有误。`;
      });

      qs('#exportProject').addEventListener('click', () => {
        readProjectForm();
        const project = state.projects[projectIndex];
        if (!project) return;
        downloadText(`${project.slug || 'project'}.md`, projectToMarkdown(project));
      });

      qs('#importProject').addEventListener('click', () => {
        const input = qs('#projectImportFile');
        input.value = '';
        input.click();
      });

      qs('#projectImportFile').addEventListener('change', async (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        readProjectForm();
        try {
          const project = parseProjectMarkdown(await file.text(), file.name);
          const index = state.projects.findIndex((item) => item.slug === project.slug);
          if (index >= 0 && confirm(`项目 ${project.slug} 已存在，是否覆盖？`)) {
            state.projects[index] = project;
            projectIndex = index;
          } else {
            state.projects.unshift(project);
            projectIndex = 0;
          }
          setDirty(true);
          renderProjects();
        } catch (error) {
          qs('#saveMessage').textContent = error.message || '项目导入失败。';
        }
      });

      qs('#exportSettings').addEventListener('click', () => {
        readSettings();
        downloadText('settings.md', settingsToMarkdown(state.settings));
      });

      qs('#importSettings').addEventListener('click', () => {
        const input = qs('#settingsImportFile');
        input.value = '';
        input.click();
      });

      qs('#settingsImportFile').addEventListener('change', async (event) => {
        const file = event.target.files?.[0];
        if (!file) return;
        try {
          state.settings = parseSettingsMarkdown(await file.text());
          setDirty(true);
          renderSettings();
        } catch (error) {
          qs('#saveMessage').textContent = error.message || '设置导入失败。';
        }
      });

      qs('#saveAll').addEventListener('click', async () => {
        readSettings();
        readProjectForm();
        readArticleForm();
        if (!confirmSaveDiff()) return;
        const saveButton = qs('#saveAll');
        saveButton.disabled = true;
        qs('#saveMessage').textContent = '正在保存...';
        try {
          const response = await fetch('/api/admin/content', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(state)
          });
          const result = await response.json().catch(() => ({}));
          if (response.ok) {
            savedSnapshot = JSON.parse(JSON.stringify(state));
            setDirty(false);
            qs('#saveMessage').textContent = `已保存，前台已刷新。${new Date().toLocaleTimeString()}`;
            syncOpenLinks();
            if ('BroadcastChannel' in window) {
              const channel = new BroadcastChannel('codepulse-content');
              channel.postMessage({ type: 'content-saved', savedAt: result.version?.version || Date.now() });
              channel.close();
            }
            try {
              localStorage.setItem('codepulse-content-saved', String(result.version?.version || Date.now()));
            } catch {}
          } else {
            if (response.status === 401) handleSessionExpiry();
            const details = Array.isArray(result.details) ? `：${result.details.slice(0, 3).join('；')}` : '';
            qs('#saveMessage').textContent = `${result.error || '保存失败，请重试'}${details}`;
          }
        } catch {
          qs('#saveMessage').textContent = '保存失败，请检查网络或服务状态。';
        } finally {
          saveButton.disabled = false;
        }
      });

      qs('#logout').addEventListener('click', async () => {
        if (isDirty && !confirm('还有未保存更改，确定退出？')) return;
        await fetch('/api/admin/logout', { method: 'POST' });
        location.reload();
      });

      fetch('/api/admin/content')
        .then(async (response) => {
          if (response.status === 401) {
            handleSessionExpiry();
            throw new Error('Session expired');
          }
          if (!response.ok) throw new Error('Unable to load admin content');
          return response.json();
        })
        .then((data) => {
          state = data;
          savedSnapshot = JSON.parse(JSON.stringify(data));
          try {
            const recovery = sessionStorage.getItem('codepulse-admin-recovery');
            if (recovery) {
              sessionStorage.removeItem('codepulse-admin-recovery');
              const recoveredState = JSON.parse(recovery);
              if (confirm('检测到登录过期前未保存的内容，是否恢复继续编辑？')) {
                state = recoveredState;
                setDirty(true);
              }
            }
          } catch {}
          renderSettings();
          renderProjects();
          renderArticles();
          syncOpenLinks();
        })
        .catch(() => undefined);
    }
  </script>
</BaseLayout>

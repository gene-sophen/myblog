    }

    @media (max-width: 1380px) {
      #articleForm .article-heading-block,
      #articleForm .article-meta-block {
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 1180px) {
      .media-toolbar {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .media-summary {

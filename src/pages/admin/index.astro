      }
    }

    @media (max-width: 760px) {
      .media-toolbar {
        grid-template-columns: 1fr;
      }

      .media-summary {
        text-align: left;
      }

      .media-grid {
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      }

      .import-grid {
        grid-template-columns: 1fr;
      }

      .content-editor-grid {
        grid-template-columns: 1fr;
      }

      #articleForm .article-writing-block .content-editor-grid {
        grid-template-columns: 1fr;
      }

      #articleForm .article-writing-block [data-field="excerpt"],
      #articleForm .article-writing-block [data-field="content"] {
        grid-column: 1;
      }

      #articleForm .article-writing-block .content-textarea {
        min-height: 400px;
      }

      .content-editor-block {

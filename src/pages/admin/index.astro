          <select id="articleSort" aria-label="文章排序方式">
            <option value="date-desc" ${articleFilters.sort === 'date-desc' ? 'selected' : ''}>发布时间：最新优先</option>
            <option value="date-asc" ${articleFilters.sort === 'date-asc' ? 'selected' : ''}>发布时间：最早优先</option>
            <option value="title-asc" ${articleFilters.sort === 'title-asc' ? 'selected' : ''}>标题：A 到 Z</option>
          </select>
          <span class="article-list-meta">显示 ${entries.length} / ${state.articles.length} 篇</span>
        `;
        qs('#articleList').innerHTML = visibleEntries.length
          ? visibleEntries.map(({ article, index }) => (
              `<button class="record-item ${index === articleIndex ? 'active' : ''}" type="button" data-article="${index}"><strong>${escapeHtml(article.title)}</strong><br><span>${escapeHtml(statusLabel[article.status] || '草稿')} · ${escapeHtml(articleKindDefaults[article.kind] || article.kind)} · ${escapeHtml(article.date)}</span></button>`

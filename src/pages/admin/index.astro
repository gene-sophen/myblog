        qs('#articlePagination').innerHTML = `
          <button type="button" data-article-page="previous" aria-label="上一页" title="上一页" ${articlePage === 1 ? 'disabled' : ''}>&lt;</button>
          <span>${entries.length ? `${articlePage} / ${totalPages}` : '0 / 0'}</span>
          <button type="button" data-article-page="next" aria-label="下一页" title="下一页" ${articlePage >= totalPages || !entries.length ? 'disabled' : ''}>&gt;</button>
        `;
        qsa('[data-article]').forEach((button) => button.addEventListener('click', () => {
          readArticleForm();
          articleIndex = Number(button.dataset.article);
          renderArticles();
        }));
        qs('#articleSearch').addEventListener('input', (event) => {
          articleFilters.query = event.target.value;
          articlePage = 1;
          renderArticleList();
        });
        qs('#articleStatusFilter').addEventListener('change', (event) => {
          articleFilters.status = event.target.value;
          articlePage = 1;
          renderArticleList();
        });
        qs('#articleKindFilter').addEventListener('change', (event) => {
          articleFilters.kind = event.target.value;
          articlePage = 1;
          renderArticleList();
        });
        qs('#articleSort').addEventListener('change', (event) => {
          articleFilters.sort = event.target.value;
          articlePage = 1;
          renderArticleList();
        });
        qsa('[data-article-page]').forEach((button) => button.addEventListener('click', () => {
          articlePage += button.dataset.articlePage === 'next' ? 1 : -1;
          renderArticleList();
        }));
      }


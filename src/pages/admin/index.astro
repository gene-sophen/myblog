      function filteredArticleEntries() {
        const query = articleFilters.query.trim().toLowerCase();
        return state.articles
          .map((article, index) => ({ article, index }))
          .filter(({ article }) => {
            const searchable = [article.title, article.slug, article.category, article.tags?.join(' ')].join(' ').toLowerCase();
            return (!query || searchable.includes(query))
              && (articleFilters.status === 'all' || article.status === articleFilters.status)
              && (articleFilters.kind === 'all' || article.kind === articleFilters.kind);
          })
          .sort((left, right) => {
            if (articleFilters.sort === 'title-asc') return String(left.article.title || '').localeCompare(String(right.article.title || ''), 'zh-CN');
            const leftDate = Date.parse(`${left.article.date || ''}T00:00:00`) || 0;
            const rightDate = Date.parse(`${right.article.date || ''}T00:00:00`) || 0;
            return articleFilters.sort === 'date-asc' ? leftDate - rightDate : rightDate - leftDate;
          });
      }

      function focusArticle(index, options = {}) {
        articleIndex = Math.max(0, Math.min(index, state.articles.length - 1));
        if (options.resetFilters) {
          articleFilters.query = '';
          articleFilters.status = 'all';
          articleFilters.kind = 'all';
        }
        const entries = filteredArticleEntries();
        const position = entries.findIndex((entry) => entry.index === articleIndex);
        articlePage = position >= 0 ? Math.floor(position / articlePageSize) + 1 : 1;
      }

      function renderArticleList() {
        const entries = filteredArticleEntries();
        const totalPages = Math.max(1, Math.ceil(entries.length / articlePageSize));
        articlePage = Math.min(articlePage, totalPages);
        const visibleEntries = entries.slice((articlePage - 1) * articlePageSize, articlePage * articlePageSize);
        const statusLabel = { published: '发布', draft: '草稿' };

        qs('#articleListTools').innerHTML = `
          <input id="articleSearch" type="search" value="${escapeHtml(articleFilters.query)}" placeholder="搜索标题、标签或 Slug" />
          <div class="article-filter-grid">
            <select id="articleStatusFilter" aria-label="发布状态筛选">
              <option value="all">全部状态</option>
              <option value="published" ${articleFilters.status === 'published' ? 'selected' : ''}>已发布</option>
              <option value="draft" ${articleFilters.status === 'draft' ? 'selected' : ''}>草稿</option>
            </select>
            <select id="articleKindFilter" aria-label="文章类型筛选">
              <option value="all">全部类型</option>
              ${articleKinds.map((kind) => `<option value="${escapeHtml(kind)}" ${articleFilters.kind === kind ? 'selected' : ''}>${escapeHtml(articleKindDefaults[kind])}</option>`).join('')}

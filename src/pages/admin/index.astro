          `, 'article-writing-block')}

          <div class="form-actions"><button class="btn secondary" id="deleteArticle" type="button">删除文章</button></div>
        `;
        qs('#copyArticlePath').addEventListener('click', async () => {
          await navigator.clipboard?.writeText(sourcePath).catch(() => undefined);
          qs('#saveMessage').textContent = '源文件路径已复制。';
        });
        qs('#generateArticleSlug').addEventListener('click', () => {
          const formEl = qs('#articleForm');
          const title = formEl.querySelector('[name="title"]')?.value || '';

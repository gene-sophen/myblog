---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAuthed } from '../../lib/auth';
import { getSettings } from '../../lib/content';

const settings = await getSettings();
const authed = await isAuthed({ cookies: Astro.cookies, request: Astro.request });
---
<BaseLayout settings={settings} title={settings.adminTitle}>
  <section class="admin-container">
    <div class="section-head">
      <p class="eyebrow">Content Studio</p>
      <h1 class="page-title">{settings.adminTitle}</h1>
      <p class="page-intro">维护站点设置、项目生命周期和 Markdown 内容源。</p>
    </div>

    {!authed ? (
      <form id="loginForm" class="glass-card admin-login">
        <label>
          管理密码
          <input name="password" type="password" placeholder="请输入 ADMIN_PASSWORD" required />
        </label>
        <button class="btn" type="submit">登录</button>
        <p id="loginMessage" class="muted"></p>
      </form>
    ) : (
      <div id="studio" class="admin-shell">
        <aside class="glass-card admin-sidebar">
          <button class="studio-tab active" data-tab="settings">站点设置</button>
          <button class="studio-tab" data-tab="projects">项目维护</button>
          <button class="studio-tab" data-tab="articles">文章维护</button>
          <button class="studio-tab" data-tab="media">图床管理</button>
          <button id="saveAll" class="btn" type="button">保存全部</button>
          <a class="btn secondary" href="/" target="_blank" rel="noreferrer">查看前台</a>
          <button id="logout" class="btn secondary" type="button">退出</button>
          <p id="saveMessage" class="muted"></p>
        </aside>

        <section class="glass-card admin-panel" data-panel="settings">
          <div class="panel-head studio-panel-head">
            <div>
              <p class="eyebrow">Site Profile</p>
              <h2 class="card-title">站点设置</h2>
              <p class="panel-desc">维护首页名片、站点标题、状态播报和联系方式。</p>
            </div>
            <div class="panel-actions">
              <button class="btn secondary" id="importSettings" type="button">导入设置</button>
              <button class="btn secondary" id="exportSettings" type="button">导出设置</button>
              <a class="btn secondary" href="/" target="_blank" rel="noreferrer">打开首页</a>
              <input id="settingsImportFile" class="hidden-file-input" type="file" accept=".md,text/markdown,text/plain" />
            </div>
          </div>
          <div class="admin-workbench">
            <div class="editor-surface">
              <form id="settingsForm" class="settings-board"></form>
            </div>
          </div>
        </section>

        <section class="glass-card admin-panel hidden" data-panel="projects">
          <div class="panel-head studio-panel-head">
            <div>
              <p class="eyebrow">Project Library</p>
              <h2 class="card-title">项目维护</h2>
              <p class="panel-desc">维护项目生命周期、进度、架构节点，并保存为项目 Markdown 文件。</p>
            </div>
            <div class="panel-actions">
              <button class="btn secondary" id="importProject" type="button">导入项目</button>
              <button class="btn secondary" id="exportProject" type="button">导出项目</button>
              <a class="btn secondary" id="projectPreviewLink" href="/projects" target="_blank" rel="noreferrer">打开项目页</a>
              <button class="btn secondary" id="newProject" type="button">新增项目</button>
              <input id="projectImportFile" class="hidden-file-input" type="file" accept=".md,text/markdown,text/plain" />
            </div>
          </div>
          <div class="admin-workbench">
            <div class="editor-surface record-editor">
              <div id="projectList" class="record-list"></div>
              <form id="projectForm" class="admin-form"></form>
            </div>
          </div>
        </section>

        <section class="glass-card admin-panel hidden" data-panel="articles">
          <div class="panel-head studio-panel-head">
            <div>
              <p class="eyebrow">Writing Desk</p>
              <h2 class="card-title">文章维护</h2>
              <p class="panel-desc">维护说明书、开发日志、工具箱、面经和随笔正文，保存为文章 Markdown 文件。</p>
            </div>
            <div class="panel-actions">
              <button class="btn secondary" id="importArticle" type="button">导入 Markdown</button>
              <button class="btn secondary" id="exportArticle" type="button">导出当前</button>
              <a class="btn secondary" id="articlePreviewLink" href="/" target="_blank" rel="noreferrer">打开文章页</a>
              <button class="btn secondary" id="uploadArticleImage" type="button">上传图片</button>
              <button class="btn secondary" id="contentAudit" type="button">内容体检</button>
              <button class="btn secondary" id="downloadArticleTemplate" type="button">下载模板</button>
              <button class="btn secondary" id="newArticle" type="button">新增文章</button>
              <input id="articleImportFile" class="hidden-file-input" type="file" accept=".md,text/markdown,text/plain" multiple />
              <input id="articleImageFile" class="hidden-file-input" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
            </div>
          </div>
          <div class="admin-workbench article-workbench">
            <div class="editor-surface record-editor article-record-editor">
              <section id="articleImportResult" class="import-panel article-import-result hidden" aria-live="polite"></section>
              <div class="article-browser">
                <div id="articleListTools" class="article-list-tools"></div>
                <div id="articleList" class="record-list"></div>
                <div id="articlePagination" class="article-pagination"></div>
              </div>
              <form id="articleForm" class="admin-form article-form"></form>
              <section id="contentAuditPanel" class="import-panel hidden"></section>
            </div>
          </div>
        </section>

        <section class="glass-card admin-panel hidden" data-panel="media">
          <div class="panel-head studio-panel-head">
            <div>
              <p class="eyebrow">Media Library</p>
              <h2 class="card-title">图床管理</h2>
              <p class="panel-desc">集中维护文章图片及其稳定访问地址。</p>
            </div>
            <div class="panel-actions">
              <button class="btn secondary" id="refreshMedia" type="button">刷新图片</button>
              <button class="btn secondary" id="uploadMedia" type="button">上传图片</button>
              <a class="btn secondary" href="/api/admin/backup">下载内容备份</a>
              <input id="mediaFiles" class="hidden-file-input" type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple />
            </div>
          </div>
          <div class="admin-workbench">
            <div class="editor-surface media-library">
              <div class="media-toolbar">
                <label>
                  <span>存储分组</span>
                  <input id="mediaFolder" type="text" value="library" maxlength="80" placeholder="例如：blog-assets" />
                </label>
                <label>
                  <span>分组筛选</span>
                  <select id="mediaFolderFilter">
                    <option value="">全部分组</option>
                  </select>
                </label>
                <label>
                  <span>搜索图片</span>
                  <input id="mediaSearch" type="search" placeholder="按文件名查找" />
                </label>
                <p id="mediaSummary" class="media-summary">正在读取图片库...</p>
              </div>
              <button id="mediaDropzone" class="media-dropzone" type="button">
                <strong>选择或拖入图片</strong>
                <span>JPG、PNG、WebP、GIF，单张不超过 5MB</span>
              </button>
              <p id="mediaMessage" class="media-message" aria-live="polite"></p>
              <div id="mediaGrid" class="media-grid" aria-live="polite"></div>
            </div>
          </div>
          <dialog id="mediaEditDialog" class="media-dialog">
            <form id="mediaEditForm" method="dialog">
              <div class="media-dialog-head">
                <div>
                  <p class="eyebrow">Edit Image</p>
                  <h3>编辑图片</h3>
                </div>
                <button class="media-dialog-close" type="button" aria-label="关闭">&times;</button>
              </div>
              <label>
                <span>图片名称</span>
                <input id="mediaEditName" type="text" maxlength="120" required />
                <small id="mediaEditExtension"></small>
              </label>
              <label>
                <span>存储分组</span>
                <input id="mediaEditFolder" type="text" maxlength="80" required />
              </label>
              <p class="media-dialog-note">修改后，文章中引用该图片的地址会自动更新。</p>
              <div class="media-dialog-actions">
                <button class="btn secondary media-dialog-cancel" type="button">取消</button>
                <button class="btn" id="saveMediaEdit" type="submit">保存修改</button>
              </div>
            </form>
          </dialog>
        </section>
      </div>
    )}
  </section>

  <style is:global>
    .admin-container {
      width: min(1760px, calc(100vw - 32px));
      margin: 0 auto;
    }

    .admin-container > .section-head {
      margin-bottom: 24px;
    }

    .admin-login {
      max-width: 520px;
      display: grid;
      gap: 18px;
      padding: 30px;
      background:
        linear-gradient(160deg, rgba(255, 255, 255, 0.9), rgba(240, 249, 255, 0.82)),
        radial-gradient(circle at 10% 0%, rgba(90, 215, 242, 0.18), transparent 14rem);
    }

    .admin-shell {
      display: grid;
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 24px;
      align-items: start;
    }

    .admin-sidebar {
      position: sticky;
      top: 92px;
      display: grid;
      gap: 10px;
      padding: 18px;
      background:
        linear-gradient(160deg, rgba(255, 255, 255, 0.92), rgba(240, 249, 255, 0.8)),
        radial-gradient(circle at 20% 0%, rgba(90, 215, 242, 0.22), transparent 12rem);
    }

    .studio-tab {
      min-height: 46px;
      border: 1px solid rgba(135, 196, 237, 0.2);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.68);
      color: var(--text-secondary);
      cursor: pointer;
      font-weight: 800;
      transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
    }

    .studio-tab:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-soft);
    }

    .studio-tab.active {
      color: white;
      border-color: transparent;
      background: linear-gradient(135deg, var(--sky-blue), var(--bright-cyan));
      box-shadow: var(--shadow-medium);
    }

    #saveMessage {
      min-height: 40px;
      padding: 8px 4px 0;
      font-size: 13px;
      line-height: 1.45;
    }

    .admin-panel {
      padding: 28px;
      min-height: 720px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(245, 255, 250, 0.78)),
        radial-gradient(circle at 100% 0%, rgba(112, 244, 191, 0.18), transparent 16rem);
    }

    .hidden {
      display: none !important;
    }

    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 18px;
    }

    .studio-panel-head {
      padding-bottom: 18px;
      border-bottom: 1px solid rgba(135, 196, 237, 0.14);
    }

    .panel-desc {
      margin: 5px 0 0;
      color: var(--text-tertiary);
      font-size: 14px;
    }

    .admin-workbench {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      align-items: start;
    }

    .editor-surface {
      min-width: 0;
      border: 1px solid rgba(255, 255, 255, 0.6);
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.62);
      box-shadow: 0 18px 48px rgba(90, 215, 242, 0.12);
      backdrop-filter: blur(14px);
    }

    .editor-surface {
      padding: 18px;
    }

    .record-editor {
      display: grid;
      grid-template-columns: minmax(220px, 260px) minmax(420px, 1fr);
      gap: 18px;
    }

    .record-list {
      max-height: 690px;
      display: grid;
      align-content: start;
      gap: 10px;
      overflow: auto;
      padding-right: 4px;
    }

    .record-item {
      border: 1px solid rgba(135, 196, 237, 0.18);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.72);
      padding: 13px 14px;
      color: var(--text-secondary);
      cursor: pointer;
      text-align: left;
      box-shadow: 0 8px 24px rgba(135, 196, 237, 0.08);
      transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
    }

    .record-item strong {
      display: block;
      margin-bottom: 2px;
      color: var(--text-primary);
      font-family: var(--font-display);
      font-size: 14px;
      line-height: 1.3;
    }

    .record-item span {
      color: var(--text-tertiary);
      font-family: var(--font-mono);
      font-size: 11px;
    }

    .record-item:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-soft);
    }

    .record-item.active {
      color: white;
      border-color: transparent;
      background: linear-gradient(135deg, var(--sky-blue), var(--bright-cyan));
      box-shadow: var(--shadow-medium);
    }

    .record-item.active strong,
    .record-item.active span {
      color: white;
    }

    .article-browser {
      position: sticky;
      top: 108px;
      min-width: 0;
      padding: 2px 8px 4px 2px;
      border-right: 1px solid rgba(135, 196, 237, 0.12);
    }

    .article-import-result,
    #contentAuditPanel {
      grid-column: 1 / -1;
    }

    .article-workbench {
      grid-template-columns: minmax(0, 1fr);
    }

    .article-record-editor {
      grid-template-columns: minmax(210px, 248px) minmax(0, 1fr);
    }

    .article-list-tools {
      display: grid;
      gap: 8px;
      padding-bottom: 10px;
    }

    .article-list-tools input,
    .article-list-tools select {
      width: 100%;
      min-height: 38px;
      padding: 8px 10px;
      border: 1px solid rgba(135, 196, 237, 0.22);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.8);
      color: var(--text-primary);
      font-size: 12px;
    }

    .article-filter-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .article-list-meta {
      color: var(--text-tertiary);
      font-family: var(--font-mono);
      font-size: 11px;
    }

    .article-browser .record-list {
      position: static;
      max-height: min(52vh, 540px);
      padding: 0 2px 0 0;
      border: 0;
    }

    .article-empty {
      padding: 18px 10px;
      color: var(--text-tertiary);
      font-size: 13px;
      line-height: 1.6;
    }

    .article-pagination {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding-top: 10px;
      color: var(--text-tertiary);
      font-family: var(--font-mono);
      font-size: 11px;
    }

    .article-pagination button {
      display: grid;
      width: 30px;
      height: 30px;
      place-items: center;
      padding: 0;
      border: 1px solid rgba(135, 196, 237, 0.22);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.76);
      color: var(--text-primary);
      cursor: pointer;
    }

    .article-pagination button:disabled {
      cursor: not-allowed;
      opacity: 0.38;
    }

    .admin-form {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 15px;
      min-width: 0;
    }

    .settings-board {
      display: grid;
      gap: 18px;
    }

    .admin-form label {
      display: grid;
      gap: 8px;
      padding: 12px;
      color: var(--text-secondary);
      border: 1px solid rgba(135, 196, 237, 0.12);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.48);
      font-size: 12px;
      font-weight: 800;
    }

    .field-card {
      position: relative;
      overflow: hidden;
      display: grid;
      align-content: start;
      gap: 10px;
      min-height: 118px;
      padding: 14px;
      color: var(--text-secondary);
      border: 1px solid rgba(135, 196, 237, 0.13);
      border-radius: 18px;
      background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.78), rgba(240, 249, 255, 0.5)),
        radial-gradient(circle at 100% 0%, rgba(90, 215, 242, 0.1), transparent 10rem);
      font-size: 12px;
      font-weight: 800;
      box-shadow: 0 12px 34px rgba(135, 196, 237, 0.08);
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .field-card::after {
      content: "";
      position: absolute;
      right: -36px;
      bottom: -42px;
      width: 110px;
      height: 110px;
      opacity: 0.16;
      background: var(--gradient-cool);
      border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
      pointer-events: none;
    }

    .field-card:focus-within {
      transform: translateY(-2px);
      border-color: rgba(90, 215, 242, 0.45);
      box-shadow: 0 18px 44px rgba(90, 215, 242, 0.16);
    }

    .field-card.primary-field {
      background:
        linear-gradient(135deg, rgba(135, 196, 237, 0.2), rgba(255, 255, 255, 0.7)),
        radial-gradient(circle at 100% 0%, rgba(68, 232, 226, 0.16), transparent 14rem);
      border-color: rgba(90, 215, 242, 0.28);
    }

    .field-card.title-field {
      min-height: 144px;
      grid-column: span 2;
    }

    .field-card.title-field input {
      min-height: 58px;
      font-family: var(--font-display);
      font-size: clamp(26px, 4vw, 38px);
      font-weight: 900;
      line-height: 1;
      background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.88), rgba(240, 249, 255, 0.78));
    }

    .field-card.subtitle-field input,
    .field-card.identity-field input {
      min-height: 48px;
      border-radius: 999px;
      color: var(--deep-blue);
      font-weight: 800;
      background: rgba(135, 196, 237, 0.12);
    }

    .field-card.avatar-field {
      min-height: 144px;
      justify-items: center;
      text-align: center;
      background:
        radial-gradient(circle at 50% 20%, rgba(90, 215, 242, 0.24), transparent 8rem),
        rgba(255, 255, 255, 0.68);
    }

    .field-card.avatar-field .field-top {
      width: 100%;
    }

    .field-card.avatar-field input {
      width: 92px;
      height: 92px;
      padding: 0;
      color: white;
      text-align: center;
      background: var(--gradient-cool);
      border: 0;
      border-radius: 45% 55% 50% 50% / 50% 45% 55% 50%;
      box-shadow: var(--shadow-glow);
      font-family: var(--font-display);
      font-size: 40px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .field-card.name-field input {
      min-height: 52px;
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 800;
    }

    .field-card.bio-field textarea {
      min-height: 190px;
      font-size: 15px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(245, 255, 250, 0.72));
    }

    .field-card.live-field {
      min-height: 132px;
      background:
        linear-gradient(135deg, rgba(112, 244, 191, 0.14), rgba(249, 248, 113, 0.1)),
        rgba(255, 255, 255, 0.58);
      border-color: rgba(112, 244, 191, 0.28);
    }

    .field-card.live-field::before {
      content: "";
      position: absolute;
      left: 16px;
      bottom: 18px;
      width: 10px;
      height: 10px;
      background: var(--mint);
      border-radius: 999px;
      box-shadow: 0 0 14px var(--mint);
      z-index: 1;
    }

    .field-card.live-field textarea {
      min-height: 82px;
      padding-left: 36px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.76);
      line-height: 1.45;
    }

    .field-card.link-field input,
    .field-card.mail-field input,
    .field-card.location-field input,
    .field-card.studio-field input {
      min-height: 48px;
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: 13px;
    }

    .field-card.link-field input {
      color: var(--deep-blue);
    }

    .field-card.mail-field input {
      color: #2d8a5e;
    }

    .field-card.full,
    .admin-form label.full {
      grid-column: 1 / -1;
    }

    .field-top {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 10px;
      min-height: 18px;
      position: relative;
      z-index: 1;
    }

    .field-top > span:nth-child(2) {
      flex: 1;
      min-width: 0;
    }

    .admin-form input,
    .admin-form select,
    .admin-form textarea,
    .admin-login input,
    .field-card input,
    .field-card select,
    .field-card textarea {
      width: 100%;
      min-width: 0;
      border: 1px solid rgba(135, 196, 237, 0.28);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.82);
      color: var(--text-primary);
      padding: 12px 13px;
      outline: none;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.65);
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
      position: relative;
      z-index: 1;
    }

    .admin-form input:focus,
    .admin-form select:focus,
    .admin-form textarea:focus,
    .admin-login input:focus,
    .field-card input:focus,
    .field-card select:focus,
    .field-card textarea:focus {
      border-color: var(--bright-cyan);
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 0 0 4px rgba(90, 215, 242, 0.15);
    }

    .admin-form textarea,
    .field-card textarea {
      min-height: 110px;
      resize: vertical;
      font-family: var(--font-mono);
      font-size: 13px;
      line-height: 1.65;
    }

    .settings-board textarea {
      min-height: 132px;
    }

    .settings-board .live-field textarea {
      min-height: 86px;
    }

    .settings-board input::placeholder,
    .settings-board textarea::placeholder {
      color: rgba(100, 116, 139, 0.58);
    }

    .admin-form .content-textarea {
      min-height: 420px;
    }

    .article-form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .form-actions {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      padding-top: 4px;
    }

    .panel-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 10px;
    }

    .hidden-file-input {
      display: none;
    }

    .media-library {
      display: grid;
      gap: 18px;
    }

    .media-toolbar {
      display: grid;
      grid-template-columns: minmax(170px, 240px) minmax(170px, 240px) minmax(220px, 1fr) auto;
      align-items: end;
      gap: 14px;
    }

    .media-toolbar label {
      display: grid;
      gap: 7px;
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 800;
    }

    .media-toolbar input,
    .media-toolbar select {
      width: 100%;
      min-width: 0;
      min-height: 44px;
      padding: 10px 12px;
      border: 1px solid rgba(135, 196, 237, 0.28);
      border-radius: 8px;
      outline: none;
      background: rgba(255, 255, 255, 0.86);
      color: var(--text-primary);
    }

    .media-toolbar input:focus,
    .media-toolbar select:focus {
      border-color: var(--bright-cyan);
      box-shadow: 0 0 0 4px rgba(90, 215, 242, 0.14);
    }

    .media-summary,
    .media-message {
      margin: 0;
      color: var(--text-tertiary);
      font-size: 13px;
    }

    .media-summary {
      min-width: 120px;
      padding-bottom: 12px;
      text-align: right;
    }

    .media-message {
      min-height: 20px;
    }

    .media-dropzone {
      min-height: 112px;
      display: grid;
      place-content: center;
      gap: 6px;
      width: 100%;
      border: 1px dashed rgba(38, 161, 188, 0.46);
      border-radius: 8px;
      background: rgba(240, 249, 255, 0.52);
      color: var(--text-secondary);
      cursor: pointer;
      text-align: center;
      transition: border-color 0.2s ease, background 0.2s ease;
    }

    .media-dropzone span {
      color: var(--text-tertiary);
      font-size: 13px;
    }

    .media-dropzone:hover,
    .media-dropzone.drag-active {
      border-color: var(--bright-cyan);
      background: rgba(112, 244, 191, 0.12);
    }

    .media-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 14px;
    }

    .media-item {
      min-width: 0;
      overflow: hidden;
      border: 1px solid rgba(135, 196, 237, 0.2);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.82);
    }

    .media-item img {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: contain;
      background: #eef6f8;
      border-bottom: 1px solid rgba(135, 196, 237, 0.16);
    }

    .media-item-body {
      display: grid;
      gap: 8px;
      padding: 11px;
    }

    .media-item-name {
      overflow: hidden;
      margin: 0;
      color: var(--text-primary);
      font-weight: 800;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .media-item-meta {
      margin: 0;
      color: var(--text-tertiary);
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.5;
    }

    .media-item-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      padding-top: 2px;
    }

    .media-copy-action {
      padding: 0;
      border: 0;
      background: transparent;
      color: #167e95;
      cursor: pointer;
      font-size: 12px;
      font-weight: 800;
    }

    .media-copy-action:hover {
      text-decoration: underline;
    }

    .media-delete-action {
      color: #b42318;
    }

    .media-dialog {
      width: min(460px, calc(100vw - 32px));
      padding: 0;
      border: 1px solid rgba(135, 196, 237, 0.34);
      border-radius: 8px;
      background: #fff;
      box-shadow: 0 24px 70px rgba(15, 23, 42, 0.24);
    }

    .media-dialog::backdrop {
      background: rgba(15, 23, 42, 0.48);
    }

    .media-dialog form {
      display: grid;
      gap: 18px;
      padding: 24px;
    }

    .media-dialog-head,
    .media-dialog-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .media-dialog-head h3,
    .media-dialog-head p,
    .media-dialog-note {
      margin: 0;
    }

    .media-dialog label {
      display: grid;
      gap: 7px;
    }

    .media-dialog label span {
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 800;
    }

    .media-dialog label small,
    .media-dialog-note {
      color: var(--text-tertiary);
      font-size: 12px;
    }

    .media-dialog-close {
      width: 36px;
      height: 36px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--text-secondary);
      cursor: pointer;
      font-size: 26px;
      line-height: 1;
    }

    .media-dialog-actions {
      justify-content: flex-end;
    }

    .media-empty {
      grid-column: 1 / -1;
      margin: 0;
      padding: 54px 20px;
      border-top: 1px solid rgba(135, 196, 237, 0.16);
      color: var(--text-tertiary);
      text-align: center;
    }

    .import-panel {
      grid-column: 1 / -1;
      display: grid;
      gap: 14px;
      padding: 16px;
      border: 1px solid rgba(90, 215, 242, 0.22);
      border-radius: 20px;
      background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.88), rgba(240, 249, 255, 0.68));
      box-shadow: 0 16px 38px rgba(90, 215, 242, 0.11);
    }

    .import-panel-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
    }

    .import-panel h3,
    .import-panel p {
      margin: 0;
    }

    .import-panel h3 {
      font-family: var(--font-display);
      font-size: 18px;
    }

    .import-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }

    .import-field {
      display: grid;
      gap: 4px;
      min-width: 0;
      padding: 10px 12px;
      border: 1px solid rgba(135, 196, 237, 0.16);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.68);
    }

    .import-field span {
      color: var(--text-tertiary);
      font-size: 11px;
      font-weight: 900;
    }

    .import-field strong {
      overflow-wrap: anywhere;
      color: var(--text-primary);
      font-size: 13px;
      line-height: 1.35;
    }

    .import-body-preview {
      max-height: 180px;
      overflow: auto;
      padding: 12px 14px;
      border: 1px solid rgba(135, 196, 237, 0.16);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.72);
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.6;
      white-space: pre-wrap;
    }

    .import-warning,
    .import-errors {
      padding: 10px 12px;
      border-radius: 14px;
      font-size: 13px;
      line-height: 1.5;
    }

    .import-warning {
      border: 1px solid rgba(245, 158, 11, 0.25);
      background: rgba(254, 243, 199, 0.68);
      color: #8a5a00;
    }

    .import-errors {
      border: 1px solid rgba(239, 68, 68, 0.22);
      background: rgba(254, 226, 226, 0.72);
      color: #9f1239;
    }

    .import-options {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 800;
    }

    .import-options label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
    }

    .import-options input {
      accent-color: var(--bright-cyan);
    }

    .import-result-list {
      display: grid;
      gap: 8px;
    }

    .import-result-item {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 12px;
      padding: 10px 12px;
      border: 1px solid rgba(135, 196, 237, 0.16);
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.7);
    }

    .import-result-item strong,
    .import-result-item span {
      display: block;
      overflow-wrap: anywhere;
    }

    .import-result-item span {
      margin-top: 3px;
      color: var(--text-tertiary);
      font-family: var(--font-mono);
      font-size: 11px;
    }

    .source-path-card {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 12px 14px;
      border: 1px solid rgba(135, 196, 237, 0.16);
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.66);
      color: var(--text-secondary);
      font-family: var(--font-mono);
      font-size: 12px;
    }

    .article-tool-row {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    .article-tool-row select {
      width: auto;
      min-width: 180px;
      min-height: 40px;
      padding: 8px 10px;
      border: 1px solid rgba(135, 196, 237, 0.26);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.86);
      color: var(--text-primary);
    }

    @media (max-width: 1100px) {
      .admin-shell,
      .record-editor,
      .admin-form {
        grid-template-columns: 1fr;
      }

      .admin-sidebar {
        position: static;
      }

      .admin-panel {
        padding: 20px;
      }
    }

    /* Calm settings editor: clean CodePulse controls without visual clutter. */
    .settings-board {
      gap: 16px;
    }

    .field-card::after {
      display: none !important;
    }

    .field-card,
    .field-card.primary-field,
    .field-card.live-field,
    .field-card.avatar-field {
      min-height: auto;
      justify-items: stretch;
      padding: 12px;
      text-align: left;
      border-color: rgba(135, 196, 237, 0.16);
      border-radius: 16px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(255, 255, 255, 0.54));
      box-shadow: 0 8px 22px rgba(135, 196, 237, 0.07);
    }

    .field-card:focus-within {
      transform: translateY(-1px);
      border-color: rgba(90, 215, 242, 0.42);
      box-shadow: 0 12px 30px rgba(90, 215, 242, 0.14);
    }

    .field-card.title-field {
      grid-column: 1 / -1;
      min-height: auto;
    }

    .field-card.full {
      grid-column: 1 / -1;
    }

    .field-top {
      min-height: auto;
      margin-bottom: 2px;
      color: var(--text-tertiary);
      font-size: 12px;
      letter-spacing: 0;
    }

    .field-top > span:nth-child(2),
    .field-top > span:first-child {
      flex: initial;
    }

    .field-card input,
    .field-card select,
    .field-card textarea,
    .field-card.title-field input,
    .field-card.name-field input,
    .field-card.subtitle-field input,
    .field-card.identity-field input,
    .field-card.avatar-field input,
    .field-card.link-field input,
    .field-card.mail-field input,
    .field-card.location-field input,
    .field-card.studio-field input {
      width: 100%;
      height: auto;
      min-height: 44px;
      padding: 10px 12px;
      color: var(--text-primary);
      border: 1px solid rgba(135, 196, 237, 0.24);
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.82);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.68);
      font-family: var(--font-body);
      font-size: 15px;
      font-weight: 600;
      text-align: left;
      text-transform: none;
    }

    .field-card.title-field input {
      min-height: 52px;
      font-family: var(--font-display);
      font-size: clamp(24px, 3vw, 32px);
      font-weight: 850;
      background:
        linear-gradient(135deg, rgba(135, 196, 237, 0.14), rgba(255, 255, 255, 0.88));
    }

    .field-card.avatar-field input {
      max-width: 120px;
      color: white;
      text-align: center;
      background: var(--gradient-cool);
      border: 0;
      border-radius: 18px;
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 900;
    }

    .field-card.bio-field textarea {
      min-height: 150px;
    }

    .field-card.live-field textarea {
      min-height: 76px;
      padding-left: 34px;
      border-radius: 18px;
      line-height: 1.55;
    }

    .field-card.live-field::before {
      left: 24px;
      bottom: 28px;
    }

    /* Componentized site settings editor */
    #settingsForm.settings-board {
      display: grid;
      gap: 18px;
    }

    .settings-hero-editor,
    .settings-content-editor,
    .settings-contact-editor {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(135, 196, 237, 0.18);
      border-radius: 24px;
      background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(240, 249, 255, 0.58)),
        radial-gradient(circle at 100% 0%, rgba(90, 215, 242, 0.13), transparent 15rem);
      box-shadow: 0 18px 46px rgba(135, 196, 237, 0.11);
    }

    .settings-hero-editor {
      display: grid;
      grid-template-columns: 150px minmax(0, 1fr);
      gap: 18px;
      padding: 18px;
      align-items: stretch;
    }

    .hero-avatar-editor {
      display: grid;
      justify-items: center;
      align-content: center;
      gap: 12px;
      min-height: 178px;
      padding: 16px;
      border: 1px solid rgba(90, 215, 242, 0.22);
      border-radius: 22px;
      background:
        radial-gradient(circle at 50% 18%, rgba(90, 215, 242, 0.24), transparent 8rem),
        rgba(255, 255, 255, 0.68);
    }

    .hero-avatar-editor > span,
    .setting-control > span {
      color: var(--text-tertiary);
      font-size: 12px;
      font-weight: 900;
      line-height: 1.2;
      letter-spacing: 0;
    }

    .hero-avatar-editor input {
      width: 92px;
      height: 92px;
      min-height: 92px;
      padding: 0;
      border: 0;
      border-radius: 44% 56% 48% 52% / 48% 44% 56% 52%;
      color: white;
      background: var(--gradient-cool);
      box-shadow: var(--shadow-glow);
      font-family: var(--font-display);
      font-size: 40px;
      font-weight: 900;
      line-height: 1;
      text-align: center;
      text-transform: uppercase;
    }

    .hero-brand-editor,
    .setting-control {
      display: grid;
      gap: 10px;
      min-width: 0;
    }

    .setting-control {
      align-content: start;
      min-height: 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--text-secondary);
      font-size: 12px;
      font-weight: 900;
    }

    #settingsForm .setting-control input,
    #settingsForm .setting-control textarea {
      display: block;
      width: 100%;
      min-width: 0;
      border: 1px solid rgba(135, 196, 237, 0.26);
      background: rgba(255, 255, 255, 0.82);
      color: var(--text-primary);
      outline: none;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    #settingsForm .setting-control input:focus,
    #settingsForm .setting-control textarea:focus,
    .hero-avatar-editor input:focus {
      border-color: var(--bright-cyan);
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 0 0 4px rgba(90, 215, 242, 0.15);
    }

    .brand-title-control {
      padding: 16px;
      border: 1px solid rgba(135, 196, 237, 0.14);
      border-radius: 22px;
      background:
        linear-gradient(135deg, rgba(135, 196, 237, 0.16), rgba(255, 255, 255, 0.72)),
        radial-gradient(circle at 100% 0%, rgba(68, 232, 226, 0.16), transparent 13rem);
    }

    #settingsForm .brand-title-control input {
      min-height: 66px;
      padding: 12px 14px;
      border-radius: 18px;
      font-family: var(--font-display);
      font-size: 32px;
      font-weight: 900;
      line-height: 1.1;
    }

    .brand-meta-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .soft-pill-control,
    .identity-control,
    .contact-control {
      padding: 14px;
      border: 1px solid rgba(135, 196, 237, 0.12);
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.56);
    }

    #settingsForm .soft-pill-control input,
    #settingsForm .identity-control input,
    #settingsForm .contact-control input {
      min-height: 48px;
      padding: 11px 14px;
      border-radius: 999px;
      font-size: 15px;
      font-weight: 800;
      line-height: 1.35;
    }

    .settings-content-editor {
      display: grid;
      grid-template-columns: minmax(260px, 0.82fr) minmax(320px, 1.18fr);
      gap: 14px;
      padding: 18px;
    }

    .identity-editor,
    .status-editor,
    .bio-editor {
      min-width: 0;
    }

    .identity-editor {
      grid-column: 1 / -1;
    }

    .status-editor,
    .bio-editor {
      position: relative;
      padding: 16px;
      border: 1px solid rgba(135, 196, 237, 0.14);
      border-radius: 22px;
      background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.76), rgba(245, 255, 250, 0.56)),
        radial-gradient(circle at 100% 10%, rgba(112, 244, 191, 0.12), transparent 13rem);
    }

    .status-pulse {
      position: absolute;
      left: 30px;
      bottom: 36px;
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: var(--mint);
      box-shadow: 0 0 14px var(--mint);
      z-index: 2;
    }

    #settingsForm .status-control textarea,
    #settingsForm .bio-control textarea {
      resize: vertical;
      border-radius: 18px;
      font-family: var(--font-mono);
      font-size: 14px;
      line-height: 1.7;
      white-space: pre-wrap;
    }

    #settingsForm .status-control textarea {
      min-height: 136px;
      padding: 14px 14px 14px 34px;
    }

    #settingsForm .bio-control textarea {
      min-height: 236px;
      padding: 16px;
      font-size: 15px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(245, 255, 250, 0.76));
    }

    .settings-contact-editor {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      padding: 18px;
    }

    #settingsForm .contact-control input {
      font-family: var(--font-mono);
      font-size: 13px;
    }

    @media (max-width: 980px) {
      .settings-hero-editor,
      .settings-content-editor,
      .settings-contact-editor,
      .brand-meta-grid {
        grid-template-columns: 1fr;
      }

      .hero-avatar-editor {
        min-height: 142px;
      }

      .status-editor,
      .bio-editor {
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 560px) {
      .settings-hero-editor,
      .settings-content-editor,
      .settings-contact-editor {
        padding: 14px;
        border-radius: 20px;
      }

      #settingsForm .brand-title-control input {
        font-size: 26px;
      }
    }

    /* Rebuilt left-side content editors */
    .editor-surface {
      overflow: hidden;
    }

    .record-editor {
      grid-template-columns: minmax(190px, 232px) minmax(0, 1fr);
      align-items: start;
    }

    .record-editor.article-record-editor {
      grid-template-columns: minmax(210px, 248px) minmax(0, 1fr);
    }

    .record-list {
      position: sticky;
      top: 108px;
      max-height: min(72vh, 760px);
      padding: 4px 6px 4px 2px;
      border-right: 1px solid rgba(135, 196, 237, 0.12);
    }

    .record-item {
      border-radius: 18px;
      background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.78), rgba(240, 249, 255, 0.56));
    }

    .record-item.active {
      background:
        linear-gradient(135deg, var(--sky-blue), var(--bright-cyan)),
        linear-gradient(180deg, rgba(255, 255, 255, 0.1), transparent);
    }

    #projectForm,
    #articleForm {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 16px;
      align-content: start;
      min-width: 0;
    }

    .content-editor-block {
      position: relative;
      grid-column: 1 / -1;
      overflow: hidden;
      padding: 16px;
      border: 1px solid rgba(135, 196, 237, 0.17);
      border-radius: 24px;
      background:
        linear-gradient(145deg, rgba(255, 255, 255, 0.84), rgba(240, 249, 255, 0.58)),
        radial-gradient(circle at 100% 0%, rgba(90, 215, 242, 0.12), transparent 14rem);
      box-shadow: 0 18px 44px rgba(90, 215, 242, 0.1);
    }

    .content-editor-block::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: 4px;
      background: linear-gradient(90deg, var(--sky-blue), var(--bright-cyan), var(--turquoise));
    }

    .summary-block::before,
    .article-meta-block::before {
      background: linear-gradient(90deg, var(--turquoise), var(--mint), var(--lime));
    }

    .architecture-block::before,
    .article-writing-block::before {
      background: linear-gradient(90deg, var(--mint), var(--lime), var(--lemon));
    }

    .content-editor-head {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 10px;
      align-items: center;
      margin-bottom: 14px;
    }

    .content-editor-head > span {
      width: 38px;
      height: 30px;
      display: inline-grid;
      place-items: center;
      color: var(--deep-blue);
      border: 1px solid rgba(135, 196, 237, 0.22);
      border-radius: 999px;
      background: rgba(135, 196, 237, 0.14);
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 900;
    }

    .content-editor-head h3 {
      margin: 0;
      color: var(--text-primary);
      font-family: var(--font-display);
      font-size: 18px;
      line-height: 1.2;
    }

    .content-editor-grid {
      display: grid;
